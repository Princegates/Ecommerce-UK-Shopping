# Copy to .env.local and fill in. Every provider key below can instead be entered in
# Admin > Integrations (stored encrypted). An environment value always wins over a saved one.

# --- Required in production -------------------------------------------------
# Admin sign-in. The secret must be at least 16 characters; it signs admin sessions.
ADMIN_PASSWORD=
ADMIN_SECRET=
# Public address of the site, no trailing slash. Used for payment return and webhook URLs.
# It is never read from request headers.
APP_URL=https://shop.example.com
# Encrypts keys saved in the admin console. Falls back to ADMIN_SECRET if unset.
SETTINGS_ENCRYPTION_KEY=
# Protects /api/cron/messages and /api/cron/fx (send as "Authorization: Bearer <value>").
# The endpoints return 404 until this is set.
CRON_SECRET=

# --- Optional ----------------------------------------------------------------
# SQLite file location. Default: ./data/shop.db. Put it on a persistent disk.
DATABASE_PATH=
# Enables the pretend payment page. Always on outside production; off in production unless true.
ALLOW_DEMO_PAYMENTS=false

# Runs catalogue sources on their schedule from inside the server. Set to false to use /api/cron/ingest instead.
INGEST_AUTORUN=true

# Development only: create made-up sample shops and products on a new database. Leave unset in production.
# SEED_SAMPLE_DATA=true

# --- Payments (any one is enough) -------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHARGE_CURRENCY=GBP
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# --- SMS / WhatsApp / email --------------------------------------------------
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=order_update
WHATSAPP_TEMPLATE_LANGUAGE=en
RESEND_API_KEY=
RESEND_FROM=
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=

# --- Catalogue APIs (or enter them in Admin > Integrations)
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_ENVIRONMENT=production
DIFFBOT_TOKEN=

# --- Exchange-rate feed (optional; the admin-set rate stays in charge) -------
EXCHANGERATE_API_KEY=
OPENEXCHANGERATES_APP_ID=
